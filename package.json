{
  "name": "next-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "biome:check": "biome check .",
    "biome:write": "biome check --write .",
    "biome:format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.7",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "sass": "^1.105.1",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.3",
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,scss}": [
      "pnpm biome check --write --no-errors-on-unmatched",
      "bash -c 'tsc --noEmit'"
    ]
  }
}
